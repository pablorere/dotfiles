#!/usr/bin/env bash

# Enable error logging
_LOG_DIR="$HOME/.config/bspwm/logs"
[ -d "$_LOG_DIR" ] || mkdir -p "$_LOG_DIR"
exec 2>>"$_LOG_DIR/$(basename "$0").log"


FILE=/tmp/target

if [ $# -eq 0 ]; then
	if [ -e "$FILE" ]; then
		cat $FILE
	else
		printf "No Target"
	fi
elif [ "$1" = "reset" ]; then
	rm /tmp/target
else
	echo "$1" > $FILE
fi
