# jgmenu
~button3
    win=$(xdotool getmouselocation --shell | sed -n 's/^WINDOW=\(.*\)/\1/p'); \
    type=$(xprop -id "$win" _NET_WM_WINDOW_TYPE 2>/dev/null); \
    case "$type" in *DESKTOP*) \
        jgmenu_run ;; esac

# Power off, Reboot, Log out, Lockscreen, kill an app, soft reload
ctrl + super + alt + {p,r,q,l,k,s}
    {loginctl poweroff || sudo poweroff,loginctl reboot || sudo reboot,bspc quit,ScreenLocker,xkill,SoftReload}

# Hide/Show Bar (Polybar and/or eww)
